# Dealership Data Platform: environment variable names, with no values.
#
# This file is for reference. You normally do not fill it in by hand:
# - `ddp init` writes this same list into your dealership's own repository.
# - On the server, `bin/install.sh` writes /opt/ddp/.env from the answers you type.
# - Integration and email secrets go in /opt/ddp/.env.scheduler (mode 0600);
#   see README.md and docs/deployment.md.
#
# Never commit a populated environment file. .gitignore blocks every .env*
# file except this one.

# Database passwords: generate each independently with openssl rand -hex 32.
POSTGRES_PASSWORD=
OWNER_DATABASE_PASSWORD=
API_DATABASE_PASSWORD=
SCHEDULER_DATABASE_PASSWORD=
JOB_DATABASE_PASSWORD=
BACKUP_DATABASE_PASSWORD=
READONLY_DATABASE_PASSWORD=
TUNNEL_TOKEN=
DDP_IMAGE_DIGEST=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_AGE_IDENTITY=
# Optional host paths (defaults are documented in docs/deployment.md).
POSTGRES_DATA_PATH=
BACKUP_STAGING_PATH=
# Direct CLI connections, when needed outside production Compose.
DATABASE_URL=
SCHEDULER_DATABASE_URL=
JOB_DATABASE_URL=
OWNER_DATABASE_URL=
BACKUP_DATABASE_URL=
